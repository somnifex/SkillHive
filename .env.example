APP_NAME=SkillHive
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./data/skillhive.db
JWT_SECRET_KEY=replace-with-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# CORS_ORIGINS also accepts additional origins so a browser client can point
# at this server from another address; the desktop client (Tauri webview)
# authenticates with Bearer tokens from the OS keyring and does not rely on
# cookies. Add e.g. "http://tauri.localhost" when browser-mode CORS errors
# appear in the desktop webview.
COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Skill package storage backend. "local" writes verified blobs under
# BLOB_STORAGE_PATH; "s3" writes to the bucket below. The active backend can
# be switched at runtime by the system admin (system_settings table,
# /admin/system/settings); these environment values are the defaults and
# ALWAYS hold the S3 credentials — they are never stored in the database.
BLOB_STORAGE_BACKEND=local
BLOB_STORAGE_PATH=./data/blobs
S3_ENDPOINT_URL=
S3_BUCKET=
S3_PREFIX=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Docker Compose development defaults (change for any shared environment)
POSTGRES_DB=skillhive
POSTGRES_USER=skillhive
POSTGRES_PASSWORD=skillhive-dev-only
MYSQL_DATABASE=skillhive
MYSQL_USER=skillhive
MYSQL_PASSWORD=skillhive-dev-only
MYSQL_ROOT_PASSWORD=root-dev-only
SEED_DEMO=true
